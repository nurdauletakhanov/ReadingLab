---
import { withBase } from '../lib/paths';
import { fmtTime } from '../lib/srt';
import type { Chapter } from '../lib/srt';
interface Props { src: string; vtt: string; poster?: string; title: string; chapters: Chapter[] }
const { src, vtt, poster, title, chapters } = Astro.props;
---
<div class="player" data-player>
  <video controls playsinline preload="metadata" poster={poster ? withBase(poster) : undefined} aria-label={title}>
    <source src={withBase(src)} type="video/mp4" />
    <track kind="subtitles" srclang="en" label="English" src={withBase(vtt)} default />
  </video>
</div>
{chapters.length > 1 && (
  <section>
    <h2>Chapters</h2>
    <ol class="chapters" data-chapters>
      {chapters.map((c) => (
        <li>
          <button type="button" class="chapter" data-t={c.t} aria-pressed="false">
            <span class="ts">{fmtTime(c.t)}</span><span>{c.title}</span>
          </button>
        </li>
      ))}
    </ol>
  </section>
)}
<script>
  const v = document.querySelector<HTMLVideoElement>('[data-player] video');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-chapters] .chapter')];
  if (v) {
    const seek = (t: number) => { v.currentTime = t; v.play(); history.replaceState(null, '', `#t=${Math.floor(t)}`); };
    for (const b of buttons) b.addEventListener('click', () => seek(Number(b.dataset.t)));
    v.addEventListener('timeupdate', () => {
      let cur: HTMLButtonElement | null = null;
      for (const b of buttons) {
        if (v.currentTime >= Number(b.dataset.t)) cur = b;
        b.classList.remove('active'); b.setAttribute('aria-pressed', 'false');
      }
      if (cur) { cur.classList.add('active'); cur.setAttribute('aria-pressed', 'true'); }
    });
    const m = /[#&]t=(\d+)/.exec(location.hash);
    if (m) {
      const t = Number(m[1]);
      if (v.readyState >= 1) v.currentTime = t;
      else v.addEventListener('loadedmetadata', () => { v.currentTime = t; }, { once: true });
    }
  }
</script>
<style>
  .player { box-shadow: 0 8px 28px rgba(0,0,0,.18); border-radius: 10px; }
  video { width: 100%; display: block; border-radius: 10px; background: var(--player-bg); aspect-ratio: 16 / 9; }
  h2 { font-family: var(--serif); font-weight: 600; font-size: 1.25rem; margin: 1.5rem 0 .6rem; }
  .chapters { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .chapter {
    display: flex; gap: .9rem; align-items: baseline; width: 100%; text-align: left;
    background: none; border: none; border-bottom: 1px solid var(--line);
    padding: .55rem .35rem; color: var(--text); font: inherit; font-size: .95rem;
    cursor: pointer; border-radius: 6px; transition: background .15s;
  }
  .chapter:hover, .chapter.active { background: var(--accent-soft); }
  .chapter:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ts { font-family: var(--mono); font-size: .8rem; color: var(--accent); min-width: 2.9rem; font-variant-numeric: tabular-nums; }
</style>
