---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import KeyResults from '../../components/KeyResults.astro';
import { withBase } from '../../lib/paths';
import { parseSrt, readSrt, resolveChapters } from '../../lib/srt';

export async function getStaticPaths() {
  const all = await getCollection('videos');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const cues = parseSrt(await readSrt(d.srt));
const chapters = resolveChapters(cues, d.chapters, entry.id);
const tutorial = d.tutorial ? await getEntry(d.tutorial) : undefined;
const transcript = cues.map((c) => c.text).join(' ');
---
<BaseLayout title={d.title} description={d.summary} math={d.keyResults.length > 0}>
  <header>
    {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
    <h1 class="page-title">{d.title}</h1>
    <p class="cite">
      {d.paper.authors} — {d.paper.url ? <a href={d.paper.url} rel="noopener">{d.paper.title}</a> : d.paper.title}{d.paper.venue ? `, ${d.paper.venue}` : ''}, {d.paper.year}
    </p>
  </header>
  <div style="height: 1.25rem"></div>
  <VideoPlayer src={d.mp4} vtt={`videos/${entry.id}/captions.vtt`} poster={d.poster} title={d.title} chapters={chapters} />
  <KeyResults items={d.keyResults} />
  {tutorial && (
    <p class="companion">Companion tutorial: <a href={withBase(`/tutorials/${tutorial.id}/`)}>{tutorial.data.title}</a></p>
  )}
  <details class="transcript">
    <summary>Transcript</summary>
    <p>{transcript}</p>
  </details>
</BaseLayout>
<style>
  .companion { margin-top: 1.5rem; }
  .transcript { margin-top: 1.5rem; color: var(--muted); font-size: .92rem; }
  .transcript summary { cursor: pointer; color: var(--text); font-family: var(--mono); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
  .transcript p { margin-top: .75rem; }
</style>
