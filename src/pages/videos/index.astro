---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { withBase } from '../../lib/paths';
import { fmtTime } from '../../lib/srt';
const videos = (await getCollection('videos')).sort((a, b) => a.data.session - b.data.session);
---
<BaseLayout title="Videos" description="Animated paper walkthroughs with narration, subtitles and chapters.">
  <p class="eyebrow">Videos</p>
  <h1 class="page-title">Animated walkthroughs</h1>
  <p class="lede">Every curve computed, never eyeballed. Subtitles and chapter markers on each one.</p>
  <ul class="cards">
    {videos.map((v) => (
      <Card
        href={withBase(`/videos/${v.id}/`)}
        kicker={`Session ${v.data.session}${v.data.durationSec ? ` · ${fmtTime(v.data.durationSec)}` : ''}`}
        title={v.data.title}
        summary={v.data.summary}
        meta={`${v.data.paper.authors}, ${v.data.paper.year}`}
      />
    ))}
  </ul>
</BaseLayout>
