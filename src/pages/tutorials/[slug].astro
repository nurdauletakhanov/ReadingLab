---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const all = await getCollection('tutorials');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const video = entry.data.video ? await getEntry(entry.data.video) : undefined;
---
<BaseLayout title={entry.data.title} description={entry.data.summary} math={entry.data.hasMath} fontsHref={entry.data.fontsHref} fullBleed>
  <div class="tut-bar">
    <span>Session {entry.data.session}</span>
    <span class="tut-links">
      {entry.data.slides && <a href={withBase(entry.data.slides)} download>PowerPoint ↓</a>}
      {entry.data.slidesSource && <a href={withBase(entry.data.slidesSource)} download>Markdown slides ↓</a>}
      {video && <a href={withBase(`/videos/${video.id}/`)}>Watch the walkthrough →</a>}
    </span>
  </div>
  <article class="tut">
    <Fragment set:html={`<style>${entry.data.css}</style>`} />
    <Content />
    {entry.data.script && <script is:inline set:html={entry.data.script} />}
  </article>
</BaseLayout>
<style>
  .tut-bar {
    max-width: 780px; margin: 0 auto; padding: .6rem 1.25rem 0;
    display: flex; justify-content: space-between; gap: 1rem;
    font-family: var(--mono); font-size: .78rem; color: var(--muted);
  }
  .tut-links { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: flex-end; }
</style>
