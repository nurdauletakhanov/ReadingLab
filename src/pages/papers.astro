---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const entry = await getEntry('papers', 'reading-list');
if (!entry) throw new Error('src/content/papers/reading-list.md is missing');
const { Content } = await render(entry);
---
<BaseLayout title="Papers" description="The reading list: fifteen levels from classical statistics to frontier models.">
  <p class="eyebrow">Papers</p>
  <h1 class="page-title">{entry.data.title}</h1>
  <p class="lede">Titles link to the publisher, DOI or a Scholar search. Nothing is re-hosted here.{entry.data.updated && ` Last updated ${entry.data.updated.toISOString().slice(0, 10)}.`}</p>
  <div class="papers">
    <Content />
  </div>
</BaseLayout>
<script>
  // GFM tables are wide on phones: let each scroll on its own.
  for (const t of document.querySelectorAll('.papers table')) {
    const w = document.createElement('div'); w.className = 'table-wrap';
    t.replaceWith(w); w.append(t);
  }
</script>
